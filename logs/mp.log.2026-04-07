DEBUG : legacy.LegacyQuery.select(LegacyQuery.java:60)
SELECT A.APPLNO,
       A.CPY_SELLER,
       A.CPY_BUYER,
       A.MP_APPLYMD,
       A.GRTNO,
       A.GRTTYPE,
       A.MP_APPLAMT,
       A.KCGF_AMT,
       A.STATUS,
       A.STATUS_YMDHMS,
       A.TRA_CD,
       B.CPY_NAME BUYNAME,
       C.CPY_NAME SELLNAME
  FROM [DOB2B-SERVER].[DoB2B].DBO.INFO_GUARANTEE A 
 INNER JOIN [DOB2B-SERVER].[DoB2B].DBO.COMPANY B ON B.CPY_ID = A.CPY_BUYER  AND B.CPY_NAME LIKE CONCAT('%', '',  '%')
 INNER JOIN [DOB2B-SERVER].[DoB2B].DBO.COMPANY C ON C.CPY_ID = A.CPY_SELLER AND B.CPY_NAME LIKE CONCAT('%', '', '%')
 WHERE (A.CPY_BUYER = '123368' OR A.CPY_SELLER = '123368')
   AND A.MP_APPLYMD BETWEEN '19900101' AND '20991231'
   AND (CASE WHEN '' = '' THEN '' ELSE A.STATUS END) = ''
 ORDER BY A.MP_APPLYMD DESC


