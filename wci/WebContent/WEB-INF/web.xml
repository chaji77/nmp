<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
              version="3.0">
  <resource-ref>
    <description>DataSource</description>
    <res-ref-name>jdbc/wellcamp</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  <env-entry>
    <env-entry-name>WEBROOT</env-entry-name>
    <env-entry-type>java.lang.String</env-entry-type>
    <env-entry-value>D:/WorkSpace/wci/WebContent/</env-entry-value>
  </env-entry>
  <error-page>
    <error-code>500</error-code>
    <location>/error/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/error/not_found.jsp</location>
  </error-page>
  <session-config>
    <session-timeout>120</session-timeout>
  </session-config>
  <servlet>
    <servlet-name>ResponseTransaction</servlet-name>
    <servlet-class>kr.co.soap.kodit.ResponseTransaction</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ResponseTransaction</servlet-name>
    <url-pattern>/ResponseTransaction</url-pattern>
  </servlet-mapping>
  <listener>
    <listener-class>kr.co.funology.fw.util.SessionCountUtil</listener-class>
  </listener>
</web-app>
